/*
  # Security Headers
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  
  # Strict CSP (remove unsafe-inline/unsafe-eval)
  Content-Security-Policy: default-src 'self' saxobroko.com *.saxobroko.com; script-src 'self' 'nonce-{RANDOM}' cdnjs.cloudflare.com cdn.statically.io; style-src 'self' 'unsafe-inline' fonts.googleapis.com cdnjs.cloudflare.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: *.statically.io cdn.statically.io; media-src 'self'; connect-src 'self'; frame-src 'self' www.youtube-nocookie.com open.spotify.com; object-src 'none'; upgrade-insecure-requests; base-uri 'self';
  
  # Performance Headers  
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Vary: Accept-Encoding
