  Content-Security-Policy: default-src 'self' saxobroko.com *.saxobroko.com; script-src 'self' 'unsafe-inline' cdnjs.cloudflare.com cdn.statically.io unpkg.com cse.google.com www.google.com *.google.com *.gstatic.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com cdnjs.cloudflare.com www.gstatic.com data:; font-src 'self' fonts.gstatic.com data:; img-src 'self' data: blob: *.statically.io cdn.statically.io *.google.com *.gstatic.com *.googleapis.com; media-src 'self' *.saxobroko.com; connect-src 'self' *.saxobroko.com cloudflareinsights.com cse.google.com www.google.com *.google.com *.gstatic.com; frame-src 'self' www.youtube-nocookie.com open.spotify.com www.google.com cse.google.com; object-src 'none'; upgrade-insecure-requests; base-uri 'self'; frame-ancestors 'self'; manifest-src 'self'
