---
permalink: "/games.html"
layout: "base.njk"
title: "Games"
active: "games"
scripts: "dark"
description: "Browser games on Saxo_Broko — singleplayer, multiplayer, and a couple online. Making stuff since 2015."
schemaGames: true
---
<section>
  <div class="inner gamesinn">
    <header>
      <h1>Games</h1>
      <p class="section-lede">A pile of browser games. Also see the <a href="/catalog.md">plaintext catalog</a> and <a href="https://blog.saxobroko.com" rel="noopener noreferrer">blog</a>.</p>
    </header>
    <section class="columns double">
      <div class="column">
        <header>
          <h3>Singleplayer</h3>
        </header>
        <ol>
          {% for g in catalog.games.singleplayer %}
          <li><a href="{{ g.path }}" target="_blank" rel="noopener noreferrer" class="button">{{ g.name }}</a></li><br />
          {% endfor %}
        </ol>
      </div>
      <div class="column">
        <header>
          <h3>Multiplayer</h3>
        </header>
        <ol>
          {% for g in catalog.games.multiplayer %}
          <li><a href="{{ g.path }}" target="_blank" rel="noopener noreferrer" class="button{% if g.name == 'Tron' %} w3-button w3-gray{% endif %}">{{ g.name }}</a></li><br />
          {% endfor %}
        </ol>
      </div>
      <div class="column">
        <header>
          <h3>Online Multiplayer</h3>
        </header>
        <ol>
          {% for g in catalog.games.online %}
          <li><a href="{{ g.path }}" target="_blank" rel="noopener noreferrer" class="button">{{ g.name }}</a></li><br />
          {% endfor %}
        </ol>
      </div>
    </section>
  </div>
</section>
