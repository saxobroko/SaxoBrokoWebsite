<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title }} - Saxo_Broko</title>
<meta name="description" content="{% if description %}{{ description }}{% else %}Saxo_Broko's official website of doom, or whatever.{% endif %}">
<script>
  (function () {
    try {
      var t = localStorage.getItem("sb-theme");
      if (t !== "light" && t !== "dark") {
        if (localStorage.getItem("darkmode") === "true") t = "dark";
        else t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.setAttribute("data-theme", t);
      document.documentElement.style.colorScheme = t;
    } catch (e) {}
  })();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/main.css?v=2.7.2" />
<link rel="stylesheet" href="/assets/css/cool.css?v=2.7.2" />
{% if scripts == "gallery" %}
<link rel="stylesheet" href="/assets/css/magnific-popup.min.css" />
{% endif %}
{% if preloadBanner %}
<link
  rel="preload"
  as="image"
  type="image/avif"
  imagesrcset="/images/banner-960.avif 960w, /images/banner-1600.avif 1600w, /images/banner-2400.avif 2400w, /images/banner-3200.avif 3200w"
  imagesizes="100vw"
/>
{% endif %}
<script type="speculationrules">
{
  "prerender": [{
    "where": {
      "and": [
        { "href_matches": "/*" },
        { "not": { "href_matches": "/games/*" } },
        { "not": { "href_matches": "/tools/*" } },
        { "not": { "href_matches": "/*\\?*" } },
        { "not": { "selector_matches": "[target=_blank]" } },
        { "not": { "selector_matches": "[download]" } }
      ]
    },
    "eagerness": "moderate"
  }]
}
</script>
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2">
<link rel="manifest" href="/site.webmanifest?v=2">
<link rel="mask-icon" href="/safari-pinned-tab.svg?v=2" color="#000000">
<link rel="shortcut icon" href="/favicon.ico?v=2">
<meta name="msapplication-TileColor" content="#0b0d10">
<meta name="theme-color" content="#0b0d10">
