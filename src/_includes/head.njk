<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title }} - Saxo_Broko</title>
<meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
{%- set canonicalPath = permalink or page.url or "/" -%}
{%- if canonicalPath == "/" or canonicalPath == "/index.html" -%}
{%- set canonicalUrl = site.url + "/" -%}
{%- else -%}
{%- set canonicalUrl = site.url + canonicalPath -%}
{%- endif -%}
<link rel="canonical" href="{{ canonicalUrl }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="en_AU">
<meta property="og:type" content="{% if active == 'about' %}profile{% else %}website{% endif %}">
<meta property="og:title" content="{{ title }} - Saxo_Broko">
<meta property="og:description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
<meta property="og:url" content="{{ canonicalUrl }}">
<meta property="og:image" content="{% if ogImage %}{{ ogImage }}{% else %}{{ site.ogImage }}{% endif %}">
<meta property="og:image:alt" content="Saxo_Broko">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@Saxo_BrokoYT">
<meta name="twitter:creator" content="@Saxo_BrokoYT">
<meta name="twitter:title" content="{{ title }} - Saxo_Broko">
<meta name="twitter:description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
<meta name="twitter:image" content="{% if ogImage %}{{ ogImage }}{% else %}{{ site.ogImage }}{% endif %}">
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt">
<link rel="alternate" type="text/markdown" href="/catalog.md" title="Catalog">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<script>
  (function () {
    try {
      var t = localStorage.getItem("sb-theme");
      if (t !== "light" && t !== "dark") {
        if (localStorage.getItem("darkmode") === "true") t = "dark";
        else t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.setAttribute("data-theme", t);
      document.documentElement.style.colorScheme = t;
    } catch (e) {}
  })();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/main.css?v=2.8.0" />
<link rel="stylesheet" href="/assets/css/cool.css?v=2.8.0" />
{% if scripts == "gallery" %}
<link rel="stylesheet" href="/assets/css/magnific-popup.min.css" />
{% endif %}
{% if preloadBanner %}
<link
  rel="preload"
  as="image"
  type="image/avif"
  imagesrcset="/images/banner-960.avif 960w, /images/banner-1600.avif 1600w, /images/banner-2400.avif 2400w, /images/banner-3200.avif 3200w"
  imagesizes="100vw"
/>
{% endif %}
<script type="speculationrules">
{
  "prerender": [{
    "where": {
      "and": [
        { "href_matches": "/*" },
        { "not": { "href_matches": "/games/*" } },
        { "not": { "href_matches": "/tools/*" } },
        { "not": { "href_matches": "/*\\?*" } },
        { "not": { "selector_matches": "[target=_blank]" } },
        { "not": { "selector_matches": "[download]" } }
      ]
    },
    "eagerness": "moderate"
  }]
}
</script>
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2">
<link rel="manifest" href="/site.webmanifest?v=2">
<link rel="mask-icon" href="/safari-pinned-tab.svg?v=2" color="#000000">
<link rel="shortcut icon" href="/favicon.ico?v=2">
<meta name="msapplication-TileColor" content="#0b0d10">
<meta name="theme-color" content="#0b0d10">
<meta name="impact-site-verification" content="e4761248-8ce5-42f1-b1ac-74d44c1cfab2">
