{# scripts: lean | dark | shell | gallery #}
{% if jsonLd %}
<script type="application/ld+json">{{ schema.homeGraph | jsonld | safe }}</script>
{% elif schemaPerson %}
<script type="application/ld+json">{{ schema.personGraph | jsonld | safe }}</script>
{% elif schemaGames %}
<script type="application/ld+json">{{ schema.gamesList | jsonld | safe }}</script>
{% elif schemaTools %}
<script type="application/ld+json">{{ schema.toolsList | jsonld | safe }}</script>
{% endif %}
{% if scripts == "gallery" %}
<script defer src="/assets/js/jquery.min.js"></script>
<script defer src="/assets/js/magnific.js"></script>
<script defer src="/assets/js/jquery.scrolly.min.js"></script>
<script defer src="/assets/js/skel.min.js"></script>
<script defer src="/assets/js/util.js"></script>
<script defer src="/assets/js/main.js"></script>
{% elif scripts == "shell" %}
<script defer src="/assets/js/jquery.min.js"></script>
<script defer src="/assets/js/jquery.scrolly.min.js"></script>
<script defer src="/assets/js/skel.min.js"></script>
<script defer src="/assets/js/util.js"></script>
<script defer src="/assets/js/main.js"></script>
{% endif %}
{% if scripts == "dark" or scripts == "gallery" or scripts == "shell" or scripts == "lean" %}
<script defer src="/assets/js/darkmode.js?v=2.8.0"></script>
{% endif %}
<script defer src="/assets/js/site.js?v=2.8.0"></script>
{% if pwa %}
<script type="module">
  import '/assets/js/pwaupdate.js';
  const el = document.createElement('pwa-update');
  document.body.appendChild(el);
</script>
{% endif %}
{{ extraScripts | safe }}
